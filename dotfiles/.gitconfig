[user]
	name = felix
	email = xuanphuc.a1gv@gmail.com

[alias]
	co = checkout
	br = branch
	ci = commit
	st = status

[pull]
	rebase = true

[init]
	defaultBranch = main

[credential "https://github.com"]
	helper = 
	helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper = 
	helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential
