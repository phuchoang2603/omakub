#!/usr/bin/env bash

ROFI="${ROFI:-rofi}"
rofi_flags="-normal-window"

# Set the path to the Omakub directory
OMAKUB_PATH="$HOME/.local/share/omakub"
AUTO_THEME_SCRIPT="$OMAKUB_PATH/bin/auto-theme-switcher"
source "$OMAKUB_PATH/bin/theme-utils.sh"

# Define theme entries for Rofi
entries=(
  "Automatic"
  "Tokyo Night"
  "Catppuccin"
  "Nord"
  "Gruvbox"
)

# Function to enable the systemd timer for automatic theme switching
enable_systemd_timer() {
  systemctl --user enable --now theme-switcher.timer
}

# Function to disable the systemd timer for automatic theme switching
disable_systemd_timer() {
  systemctl --user disable --now theme-switcher.timer
}

# Display the theme selection menu using Rofi
choice=$(printf "%s\n" "${entries[@]}" | $ROFI $rofi_flags -dmenu -i -p "Theme")

# Process the selected theme
if [ -n "$choice" ]; then
  theme_id=$(echo "$choice" | tr '[:upper:]' '[:lower:]' | sed 's/ /-/g')
  if [ "$theme_id" == "automatic" ]; then
    enable_systemd_timer
    # Run the script once immediately after enabling
    bash "$AUTO_THEME_SCRIPT"
  else
    disable_systemd_timer
    apply_theme "$theme_id"
  fi
fi

exit 0
