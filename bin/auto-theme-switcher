#!/bin/bash

OMAKUB_PATH="$HOME/.local/share/omakub"
source "$OMAKUB_PATH/bin/theme-utils.sh"

get_theme_by_time() {
  local hour
  hour=$(date +"%-H")

  if [ "$hour" -ge 6 ] && [ "$hour" -lt 12 ]; then
    echo "gruvbox"
  elif [ "$hour" -ge 12 ] && [ "$hour" -lt 18 ]; then
    echo "nord"
  elif [ "$hour" -ge 18 ] && [ "$hour" -lt 24 ]; then
    echo "catppuccin"
  else
    echo "tokyo-night"
  fi
}

THEME=$(get_theme_by_time)
apply_theme "$THEME"
