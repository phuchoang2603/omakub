#!/usr/bin/env bash

# Use default 'rofi' if not set, and define flags
ROFI="${ROFI:-rofi}"
rofi_flags="-dmenu -normal-window -i -p Wi-Fi"

while true; do
	# --- Data Gathering (runs each time the loop starts) ---

	# Add a refresh option
	refresh="  Refresh"

	# Get the current connection status to create the correct toggle option
	if [[ "$(nmcli -t -f WIFI g)" =~ "enabled" ]]; then
		toggle="󰖪  Disable Wi-Fi"
	else
		toggle="󰖩  Enable Wi-Fi"
	fi

	# Get a formatted list of available Wi-Fi networks
	# Icons:  (refresh),  (secured),  (open), 󰖪/󰖩 (toggle)
	wifi_list=$(nmcli --fields "SECURITY,SSID" device wifi list | sed 1d | sed 's/  */ /g' | sed -E "s/WPA*.?\S/ /g" | sed "s/^--/ /g" | sed "s/  //g" | sed "/--/d")

	# Combine the refresh, toggle, and network list for the menu
	entries="$refresh\n$toggle\n$wifi_list"

	# --- Rofi Menu ---
	chosen_network=$(echo -e "$entries" | uniq -u | $ROFI $rofi_flags)

	# --- Action Handling ---

	# Exit if the user presses escape
	if [ -z "$chosen_network" ]; then
		exit 0
	fi

	# Use a case statement to handle the user's selection
	case "$chosen_network" in
	"  Refresh")
		# The 'continue' command skips the rest of the loop and starts it from the top
		continue
		;;
	"󰖩  Enable Wi-Fi")
		nmcli radio wifi on
		;;
	"󰖪  Disable Wi-Fi")
		nmcli radio wifi off
		;;
	*)
		# A network was selected, so attempt to connect.
		# Get the SSID by stripping the icon, then pipe to 'xargs' to trim whitespace.
		ssid=$(echo "$chosen_network" | sed 's/^.. //' | xargs)

		# Check if the network is already a saved connection
		if nmcli -g NAME connection | grep -q -w "^$ssid$"; then
			nmcli connection up id "$ssid"
		else
			# If it's not a saved connection, ask for a password if it's secured
			if [[ "$chosen_network" =~ "" ]]; then
				wifi_password=$(echo "" | $ROFI -dmenu -password -p "Password for '$ssid'")
			fi
			nmcli device wifi connect "$ssid" password "$wifi_password"
		fi
		# Exit the script after a connection attempt
		exit 0
		;;
	esac
done

exit 0
